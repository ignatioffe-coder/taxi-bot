# Скопируй этот файл в .env и заполни реальными значениями
# НИКОГДА не коммить файл .env в репозиторий!

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=your_token_here

# Где хранить базу данных (необязательно).
# Локально можно не указывать — база ляжет рядом с кодом.
# На хостинге обязательно указывай постоянную папку, иначе данные
# стираются при каждом обновлении бота:
#   DB_PATH=/app/data/taxi_data.db
# Bothost такую папку создаёт сам, и бот найдёт её автоматически.
# DB_PATH=/app/data/taxi_data.db
